direction: right

classes: {
  turbine: {
    shape: rectangle
    style: {
      fill: "#00CED1"
      stroke: "#f0f0f0"
      stroke-width: 1
    }
  }
  substation: {
    shape: circle
    style: {
      fill: "#FF8C00"
      stroke: "#f0f0f0"
      stroke-width: 1
    }
  }
}

T1: Turbina 1 {class: turbine}
T2: Turbina 2 {class: turbine}
T3: Turbina 3 {class: turbine}
S: Subestação {class: substation}

T4: Turbina 4 {class: turbine}
T6: Turbina 6 {class: turbine}
T5: Turbina 5 {class: turbine}

T1 -> T2: 1 unid.
T2 -> T3: 2 unid.
T3 -> S: 3 unid.

T4 -> T5: 1 unid.
T5 -> S: 3 unid.
T6 -> T5: 1 unid.
